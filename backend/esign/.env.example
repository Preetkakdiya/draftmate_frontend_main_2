# ============================================
# DraftMate E-Signature Service — Env Example
# Copy this to .env and fill in real values.
# ============================================

# --- Database (PostgreSQL) ---
# Option A: Full connection string (recommended for production)
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
DATABASE_URL=

# Option B: Individual params (used if DATABASE_URL is empty)
PGHOST=your_pg_host_here
PGPORT=5432
PGUSER=your_pg_user_here
PGPASSWORD=your_pg_password_here
PGDATABASE=your_pg_database_here
PGSSLMODE=require

# --- SMTP (Gmail for dev, Resend/SendGrid for prod) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_smtp_user_here
SMTP_PASS=your_smtp_password_here
SMTP_FROM=DraftMate <your_smtp_user_here>

# --- Auth Service (login_db microservice) ---
AUTH_SERVICE_URL=http://127.0.0.1:8009

# --- Frontend URL (for signing links in emails) ---
FRONTEND_URL=http://localhost:5173

# --- Storage Configuration ---
# Options: local | efs | s3
# Use "local" for development, "efs" for production (AWS EFS mount).
STORAGE_BACKEND=local

# Local storage path (used when STORAGE_BACKEND=local)
LOCAL_STORAGE_PATH=./storage

# AWS EFS mount path (used when STORAGE_BACKEND=efs)
# On the production server, mount your EFS filesystem at this path:
#   sudo mount -t efs fs-xxxxxxxx.efs.region.amazonaws.com:/ /mnt/efs
# Then set:
EFS_MOUNT_PATH=

# --- AWS S3 (leave empty for local; fill when switching to S3) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
S3_BUCKET=

# --- App Config ---
ENVIRONMENT=development
ESIGN_SERVICE_PORT=8020

# --- Dev Mode (skips auth verification for local testing) ---
# Set to false in production!
ESIGN_DEV_MODE=true
