# ============================================================
# DraftMate E-Signature Service — Environment Configuration
# Copy this to .env and fill in real values.
# ============================================================

# ── App Config ───────────────────────────────────────────────
# Set to "development" for local, "production" for AWS.
# When ENVIRONMENT=production, ESIGN_DEV_MODE is force-disabled
# regardless of what you set below.
ENVIRONMENT=development

# Port the service listens on
# Local testing : 8080
# AWS (Dockerfile): 8020
ESIGN_SERVICE_PORT=8020

# ── Auth ─────────────────────────────────────────────────────
# URL of the DraftMate login_db auth microservice
AUTH_SERVICE_URL=http://127.0.0.1:8009

# DEV MODE — set true only for local testing.
# Skips auth verification and uses session_id directly as user_id.
# Automatically forced to false when ENVIRONMENT=production.
ESIGN_DEV_MODE=false

# ── Database (PostgreSQL / RDS) ───────────────────────────────
# Option A (recommended): full connection string
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Option B: individual params (used only if DATABASE_URL is empty)
# PGHOST=your_pg_host
# PGPORT=5432
# PGUSER=your_pg_user
# PGPASSWORD=your_pg_password
# PGDATABASE=your_pg_database
# PGSSLMODE=require

# ── SMTP ─────────────────────────────────────────────────────
# NOTE: The esign service reads SMTP_HOST / SMTP_USER / SMTP_PASS
# (NOT SMTP_SERVER / SMTP_USERNAME / SMTP_PASSWORD)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM=DraftMate <your_email@gmail.com>

# ── Frontend URL (used in signing / download links in emails) ──
# Local  : http://localhost:5173
# AWS    : https://draftmate.in
FRONTEND_URL=http://localhost:5173

# ── Storage Backend ──────────────────────────────────────────
# Options: local | efs | s3
#
#  local  → saves to LOCAL_STORAGE_PATH on disk  (use for development)
#  efs    → saves to an AWS EFS mount point       (use for AWS ECS / EC2)
#  s3     → uploads to AWS S3 bucket              (use for AWS if no EFS)
#
STORAGE_BACKEND=local

# --- LOCAL (STORAGE_BACKEND=local) ---
LOCAL_STORAGE_PATH=./storage

# --- EFS (STORAGE_BACKEND=efs) ---
# Mount your EFS first:
#   sudo mount -t efs fs-xxxxxxxx.efs.region.amazonaws.com:/ /mnt/efs
# Then set:
EFS_MOUNT_PATH=

# --- S3 (STORAGE_BACKEND=s3) ---
# All three vars below are required when STORAGE_BACKEND=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
S3_BUCKET=your-s3-bucket-name
